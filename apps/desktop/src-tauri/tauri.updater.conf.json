  "bundle": {
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEEzNDBBQjlENTg1Qjg3ODcKUldTSGgxdFluYXRBbzkzQm5sVnJVcFVvempENDhxSTYrME9mczZuZjU4UkFNeXpQcFVMZkJ0OWkK",
