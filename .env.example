# OurShell sync server configuration.
#
# Copy this file to `.env` and fill it in before `docker compose up`. See
# `docs/self-hosting.md` for a full walkthrough and `server/src/config.rs`
# for how each of these is parsed.

# --- Required ---

# Postgres connection string. docker-compose.yml already points this at the
# bundled `postgres` service; change it only if you're using an external
# database.
DATABASE_URL=postgres://ourshell:ourshell@postgres:5432/ourshell

# Address the server listens on inside its container.
BIND_ADDR=0.0.0.0:8443

# Base64-encoded 32 random bytes. This is the server's "second layer"
# at-rest key (XChaCha20-Poly1305): it protects `items.envelope` and
# `totp.secret` against a stolen disk/backup. It is NOT the key that
# protects your vault data from the server itself -- that key never leaves
# the client. Generate one with:
#   openssl rand -base64 32
SERVER_MASTER_KEY=

# --- Optional: OPAQUE server setup persistence ---

# Base64-encoded serialized `opaque_ke::ServerSetup`. Leave unset on first
# run: the server generates one, encrypts it with SERVER_MASTER_KEY, and
# persists it in the `server_setup` table, so this almost never needs to be
# set by hand. Set it explicitly only if you're restoring a server setup
# from a backup/export outside of a normal `pg_restore`.
OPAQUE_SERVER_SETUP=

# --- Signup / invite policy ---

# Master switch for new registrations (besides the very first user, who
# always bootstraps the server as owner regardless of this and
# INVITE_ONLY).
SIGNUPS_ENABLED=true

# When true, every signup after the first user must supply a valid,
# unused invite code (see `POST /v1/orgs/invites`, admin-only).
INVITE_ONLY=false

# --- Limits ---

# Max non-revoked devices per account. 0 = unlimited.
MAX_DEVICES_PER_USER=10

# Requests per minute per client IP on the auth endpoints
# (register/*, login/*). 0 = unlimited. Only enforced when the server is
# served with connection info (always true for `docker compose up`; an
# in-process test harness that never binds a socket skips it).
RATE_LIMIT_PER_MIN=30

# Hours a session token stays valid after login/register.
SESSION_TTL_HOURS=720

# --- Optional: OIDC sign-in (e.g. company SSO) ---
#
# All four must be set together to turn OIDC on; otherwise /v1/oidc/* always
# answers 501. OIDC only *identifies* the user by email -- the master
# password (over OPAQUE) is still required afterwards to unlock the vault.

OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URL=

# --- Postgres (used by the bundled `postgres` service in docker-compose.yml) ---

POSTGRES_USER=ourshell
POSTGRES_PASSWORD=change-me
POSTGRES_DB=ourshell
